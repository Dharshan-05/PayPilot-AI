# ==============================================================================
# PayPal AI Hackathon — Environment Configuration Template
# DO NOT commit real secrets to source control.
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# Server & Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database (SQLite for local/testing, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# PayPal Sandbox Configuration
# Obtain credentials from: https://developer.paypal.com/dashboard/
# PAYPAL_PROVIDER: auto (uses Sandbox when real credentials exist, mock otherwise), paypal (forces Sandbox), mock (forces mock)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PROVIDER=auto
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# AI Provider Configuration
# Supported providers: mock, gemini, openai
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-2.0-flash

# Elasticsearch / Semantic Search Configuration
# Supported search providers: mock (deterministic in-memory), elastic, database
SEARCH_PROVIDER=mock
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=your_elastic_api_key_here
ELASTICSEARCH_INDEX=products

# APIMatic / Agent Context Configuration
# Provides structured API capability context and tool metadata modeling
APIMATIC_ENABLED=false
APIMATIC_API_KEY=your_apimatic_api_key_here
APIMATIC_BASE_URL=https://api.apimatic.io

# Security & Business Rule Policy
MAX_TRANSACTION_AMOUNT=1000.00
ALLOWED_CURRENCIES=USD,EUR,GBP,CAD,AUD
