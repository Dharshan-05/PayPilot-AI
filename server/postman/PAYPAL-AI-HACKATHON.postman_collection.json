          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Price was not tampered to 0.01', function () {",
                  "    if (pm.response.code === 201) {",
                  "        var json = pm.response.json();",
                  "        pm.expect(json.data.totalAmount).to.not.eql(0.01);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "ATTACK: AI Confirmation Bypass (Forbidden)",
          "request": {
            "method": "POST",
