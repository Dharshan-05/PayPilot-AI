        {
          "name": "ATTACK: Client Price Tampering (0.01 USD)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1,\n  \"price\": 0.01,\n  \"currency\": \"USD\",\n  \"total\": 0.01\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/commerce/proposals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "commerce", "proposals"]
